###############################################################################
# SpiderHome Fleet Monitor — configuration serveur
###############################################################################

APP_NAME="SpiderHome Fleet Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://monitor.spiderhome.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

###############################################################################
# Base métier (clients, sites, modules, alertes, SAV, utilisateurs)
# Peut être la même base que la base legacy : les tables ne se chevauchent pas.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=heap_monitoring
DB_USERNAME=spiderhome_app
DB_PASSWORD=

###############################################################################
# Base legacy (lecture seule) — tables heap_logs et module_installs
# alimentées par le collecteur Express (server.js, port 3006) et n8n.
# Utiliser un compte MySQL disposant UNIQUEMENT du SELECT sur ces tables.
###############################################################################
DB_HEAP_HOST=127.0.0.1
DB_HEAP_PORT=3307
DB_HEAP_DATABASE=heap_monitoring
DB_HEAP_USERNAME=spiderhome_ro
DB_HEAP_PASSWORD=

###############################################################################
# Règles de santé (identiques au collecteur Express)
###############################################################################
SPIDERHOME_HEAP_CRITICAL=6000
SPIDERHOME_HEAP_WARNING=8000
SPIDERHOME_FRAG_WARNING=60
SPIDERHOME_OFFLINE_MINUTES=30
SPIDERHOME_LOOKBACK_HOURS=72

# Provisionnement automatique des clients à partir de l'e-mail déclaré
SPIDERHOME_AUTO_CUSTOMERS=true
SPIDERHOME_DEFAULT_SITE="Site principal"

# Masquer e-mails et MAC dans l'adaptateur legacy (false = visibles aux opérateurs)
SPIDERHOME_MASK_LEGACY=false

# Jeton attendu sur POST /api/ingest/status (bloc « Statut » des modules).
# Vide = endpoint désactivé. Générer avec : openssl rand -hex 32
SPIDERHOME_INGEST_TOKEN=

###############################################################################
# Compte administrateur initial (utilisé une seule fois par db:seed)
###############################################################################
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=
ADMIN_PASSWORD=

###############################################################################
# Sessions / cache / files
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Domaines autorisés à consommer l'API (frontend Angular)
SANCTUM_STATEFUL_DOMAINS=monitor.spiderhome.org
FRONTEND_URL=https://monitor.spiderhome.org

###############################################################################
# E-mail — réinitialisation de mot de passe par OTP (Brevo)
# Laisser BREVO_API_KEY vide désactive la fonction « mot de passe oublié ».
###############################################################################
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@spiderhome.org"
MAIL_FROM_NAME="${APP_NAME}"
