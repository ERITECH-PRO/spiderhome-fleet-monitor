###############################################################################
# SpiderHome Fleet Monitor — environnement Docker
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Ce fichier contient des secrets : ne jamais le committer (déjà dans .gitignore).
###############################################################################

APP_NAME="SpiderHome Fleet Monitor"
APP_ENV=production
APP_DEBUG=false

# Générer une fois : docker compose run --rm api php artisan key:generate --show
APP_KEY=

# URL publique finale (celle exposée par nginx-proxy-manager)
APP_URL=https://monitor.spiderhome.org
FRONTEND_URL=https://monitor.spiderhome.org
SANCTUM_STATEFUL_DOMAINS=monitor.spiderhome.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

###############################################################################
# Base métier — conteneur mysql_central (port hôte 3307)
###############################################################################
DB_CONNECTION=mysql
DB_HOST=31.97.177.87
DB_PORT=3307
DB_DATABASE=heap_monitoring
DB_USERNAME=spiderhome_app
DB_PASSWORD=

###############################################################################
# Base legacy — mêmes tables heap_logs / module_installs, en LECTURE SEULE.
# Idéalement un second compte MySQL n'ayant que le SELECT sur ces deux tables.
###############################################################################
DB_HEAP_HOST=31.97.177.87
DB_HEAP_PORT=3307
DB_HEAP_DATABASE=heap_monitoring
DB_HEAP_USERNAME=spiderhome_ro
DB_HEAP_PASSWORD=

###############################################################################
# Règles de santé (identiques au collecteur Express)
###############################################################################
SPIDERHOME_HEAP_CRITICAL=6000
SPIDERHOME_HEAP_WARNING=8000
SPIDERHOME_FRAG_WARNING=60
SPIDERHOME_OFFLINE_MINUTES=30
SPIDERHOME_LOOKBACK_HOURS=72
SPIDERHOME_AUTO_CUSTOMERS=true
SPIDERHOME_DEFAULT_SITE="Site principal"
SPIDERHOME_MASK_LEGACY=false

# Jeton attendu sur POST /api/ingest/status — vide = endpoint désactivé.
# Générer : openssl rand -hex 32
SPIDERHOME_INGEST_TOKEN=

###############################################################################
# Compte administrateur initial — créé au premier démarrage puis à vider
###############################################################################
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=
ADMIN_PASSWORD=

###############################################################################
# Sessions / cache / files — stockés en base (aucun Redis dans cette stack)
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

###############################################################################
# E-mail — « mot de passe oublié » par OTP. Vide = fonction désactivée.
###############################################################################
BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@spiderhome.org"
MAIL_FROM_NAME="SpiderHome Fleet Monitor"
