{
	"info": {
		"_postman_id": "spiderhome-fleet-monitor-v2",
		"name": "SpiderHome Fleet Manager API",
		"description": "Collection officielle des endpoints API REST pour SpiderHome Fleet Manager (Laravel 11 / Sanctum)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentification",
			"item": [
				{
					"name": "POST Login Admin",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"ramif792@gmail.com\",\n  \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "GET Profil Connecté (/me)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/me",
							"host": ["{{baseUrl}}"],
							"path": ["me"]
						}
					}
				}
			]
		},
		{
			"name": "Clients",
			"item": [
				{
					"name": "GET Liste des Clients",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/customers?search=Ahmed",
							"host": ["{{baseUrl}}"],
							"path": ["customers"],
							"query": [{ "key": "search", "value": "Ahmed" }]
						}
					}
				},
				{
					"name": "POST Créer un Client",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ben Salah Ahmed\",\n  \"email\": \"ahmed@example.test\",\n  \"phone\": \"+216 71 123 456\",\n  \"city\": \"Tunis\",\n  \"siret\": \"98765432100019\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": ["{{baseUrl}}"],
							"path": ["customers"]
						}
					}
				}
			]
		},
		{
			"name": "Modules IoT & Diagnostic",
			"item": [
				{
					"name": "POST Enregistrer un Module (Test SN Unique)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"site_id\": 1,\n  \"model_id\": 1,\n  \"serial_number\": \"SN-001\",\n  \"mac\": \"3C:71:BF:99:12:34\",\n  \"firmware\": \"2.4.1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/devices",
							"host": ["{{baseUrl}}"],
							"path": ["devices"]
						}
					}
				},
				{
					"name": "GET Diagnostic Santé Module (/devices/{id}/health)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/devices/1/health",
							"host": ["{{baseUrl}}"],
							"path": ["devices", "1", "health"]
						}
					}
				}
			]
		},
		{
			"name": "Interventions & SAV",
			"item": [
				{
					"name": "PATCH Statut Intervention (/service-requests/{id}/status)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"in_progress\",\n  \"comment\": \"Technicien assigné sur site pour diagnostic\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/service-requests/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["service-requests", "1", "status"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000/api" },
		{ "key": "bearerToken", "value": "" }
	]
}
