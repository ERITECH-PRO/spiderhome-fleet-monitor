# SpiderHome Fleet Monitor — Nginx
# Le frontend Angular et l'API Laravel sont servis sur le même domaine,
# ce qui évite toute configuration CORS côté navigateur.
#
# Copier vers /etc/nginx/sites-available/spiderhome-monitor puis :
#   ln -s /etc/nginx/sites-available/spiderhome-monitor /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name monitor.spiderhome.org;

    # Certbot : certbot --nginx -d monitor.spiderhome.org
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name monitor.spiderhome.org;

    ssl_certificate     /etc/letsencrypt/live/monitor.spiderhome.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitor.spiderhome.org/privkey.pem;

    # ── En-têtes de sécurité ────────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 2m;

    # ── Frontend Angular (build statique) ───────────────────────────────────
    root /opt/PROJET/spiderhome-fleet-monitor/front/dist/spiderhome-dashboard/browser;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API Laravel ─────────────────────────────────────────────────────────
    location ^~ /api/ {
        alias /opt/PROJET/spiderhome-fleet-monitor/back/public/;
        try_files $uri @laravel;
    }

    location @laravel {
        root /opt/PROJET/spiderhome-fleet-monitor/back/public;
        rewrite ^ /index.php last;
    }

    location ~ ^/index\.php$ {
        root /opt/PROJET/spiderhome-fleet-monitor/back/public;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Le collecteur Express historique reste sur son port 3006 et n'est pas
    # exposé ici : les modules continuent de l'appeler directement.
    # Pour le publier en HTTPS, décommenter :
    # location /collector/ {
    #     proxy_pass http://127.0.0.1:3006/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # }

    location ~ /\. { deny all; }
}
